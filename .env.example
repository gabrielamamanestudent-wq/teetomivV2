# ============================================================================
# TEETOMIC environment configuration
# ----------------------------------------------------------------------------
# The app runs with ZERO configuration out of the box. Every integration below
# is optional and gracefully falls back to a local mock. Copy this file to
# `.env.local` only if you want to wire real services.
# ============================================================================

# Demo mode seeds fictional Montreal courses, slots, and accounts.
# Default: true
DEMO_MODE=true

# --- Supabase (optional) ----------------------------------------------------
# If omitted, the app uses an in-memory mock data layer (same interface).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (optional, test mode) -------------------------------------------
# Used ONLY for the $15 refundable deposit. If omitted, a mock payment
# provider simulates authorize / capture / refund (always succeeds).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend email (optional) ------------------------------------------------
# If omitted, confirmation emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="TEETOMIC <bookings@teetomic.golf>"

# --- Mapbox (optional) ------------------------------------------------------
# If omitted, the browse map falls back to a static list-only view.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Course demo access PIN -------------------------------------------------
# The 4-digit code a course enters on the welcome screen to unlock the
# pro-shop pitch demo (include it in outreach emails). Default: 2580
NEXT_PUBLIC_COURSE_DEMO_PIN=2580
