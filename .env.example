# ============================================================================
# TEETOMIC environment configuration
# ----------------------------------------------------------------------------
# The app runs with ZERO configuration out of the box. Every integration below
# is optional and gracefully falls back to a local mock. Copy this file to
# `.env.local` only if you want to wire real services.
# ============================================================================

# Demo mode seeds fictional Montreal courses, slots, and accounts.
# Default: true
DEMO_MODE=true

# --- Supabase (the real backend — set this for launch) ----------------------
# WITHOUT these, the app runs on an in-memory mock that RESETS on every
# serverless cold start — fine for the demo, NOT for real signups. With them,
# accounts / courses / bookings / points all persist in Postgres.
# Setup: run supabase/schema.sql once, then paste the two keys below.
# See SUPABASE_SETUP.md for the step-by-step.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (optional, test mode) -------------------------------------------
# Used for the $10 booking fee AND the TEETOMIC+ subscription. If omitted, a
# mock payment provider simulates everything (always succeeds).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# TEETOMIC+ subscription: create a $9.99/mo recurring Product in Stripe, then
# paste its Price ID here (starts with price_). Without it, "subscribe" just
# flips the flag (demo). With it, subscribing opens real Stripe Checkout.
STRIPE_PLUS_PRICE_ID=

# --- Resend email (optional) ------------------------------------------------
# If omitted, confirmation emails AND business-approval emails are logged to the
# server console instead of actually sending — this is why approval emails don't
# arrive until you configure Resend. Pending signups ALWAYS still appear in the
# /admin dashboard, so you can approve without email.
#
# To make the approval email actually land in your inbox:
#   1. Create a free Resend account (resend.com) and paste the key below.
#   2. EITHER verify the teetomic.golf domain in Resend and keep EMAIL_FROM as
#      an address on that domain (best), OR — before the domain is verified —
#      set EMAIL_FROM to "TEETOMIC <onboarding@resend.dev>". Note: with the
#      unverified onboarding sender, Resend only delivers to the email address
#      that owns your Resend account, so make APPROVALS_EMAIL that same address.
RESEND_API_KEY=
EMAIL_FROM="TEETOMIC <bookings@teetomic.golf>"

# Where new business-account approval requests are emailed. Set this to the
# inbox you actually check.
APPROVALS_EMAIL=tomictee@gmail.com

# --- AI Help Center (optional) ----------------------------------------------
# With no key, the Help Center answers from a built-in FAQ (always works).
# Add an Anthropic API key to make it a real AI assistant that answers anything.
# Get one at https://console.anthropic.com/  — paste it into Vercel env vars.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. Override for a cheaper high-traffic help desk, e.g.
# HELP_MODEL=claude-haiku-4-5

# --- Mapbox (optional) ------------------------------------------------------
# If omitted, the browse map falls back to a static list-only view.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Course demo access PIN -------------------------------------------------
# The 4-digit universal code a business enters (welcome screen or the Business
# Corner) to unlock the pitch + create their account. Default: 5432
NEXT_PUBLIC_COURSE_DEMO_PIN=5432
